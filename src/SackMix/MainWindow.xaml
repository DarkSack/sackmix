<Window x:Class="SackMix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SackMix"
        Title="SackMix" Icon="Assets/sackmix.ico"
        Width="1120" Height="720" MinWidth="780" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One program inside a channel: drag it by its icon or name to another channel. -->
        <DataTemplate x:Key="AppTemplate" DataType="{x:Type local:AppVm}">
            <Border x:Name="Row" Margin="10,0,10,8" Padding="10,7,6,8" CornerRadius="12" Background="#0AFFFFFF"
                    PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown" MouseMove="Row_MouseMove"
                    ContextMenuOpening="Row_ContextMenuOpening">
                <Border.ContextMenu>
                    <ContextMenu />
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.RowSpan="2" Width="28" Height="28" VerticalAlignment="Center" Cursor="SizeAll" ToolTip="{Binding Exe}">
                        <Border CornerRadius="8" Background="{Binding Channel.AccentSoft}">
                            <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>

                    <TextBlock Grid.Column="1" Margin="10,0,4,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold" FontSize="12.5" Cursor="SizeAll" />
                    <!-- Level meter: a line under the name. -->
                    <Border Grid.Column="1" Height="2" Margin="10,0,4,-3" VerticalAlignment="Bottom" CornerRadius="1"
                            Background="{Binding Channel.Accent}" RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Peak}" />
                        </Border.RenderTransform>
                    </Border>

                    <Slider x:Name="Level" Grid.Column="1" Grid.Row="1" Margin="10,5,4,0" Style="{StaticResource MiniSlider}"
                            Value="{Binding Volume}" Foreground="{Binding Channel.Accent}"
                            AutomationProperties.Name="{Binding Name, StringFormat=Volumen de {0}}" />

                    <ToggleButton Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource MiniMute}" IsChecked="{Binding Muted}"
                                  ToolTip="Silenciar" AutomationProperties.Name="{Binding Name, StringFormat=Silenciar {0}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter TargetName="Level" Property="Opacity" Value="0.35" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A channel: name, level, fader with meters on both sides, mute and its programs. -->
        <DataTemplate x:Key="ChannelTemplate" DataType="{x:Type local:ChannelVm}">
            <Border x:Name="Strip" Width="224" Margin="0,0,16,16" CornerRadius="20" BorderThickness="1"
                    BorderBrush="{Binding AccentSoft}" Background="{StaticResource StripBg}" AllowDrop="True"
                    DragOver="Strip_DragOver" DragLeave="Strip_DragLeave" Drop="Strip_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="230" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Height="3" Margin="26,0" VerticalAlignment="Top" CornerRadius="0,0,3,3" Background="{Binding Accent}" />
                    <Border x:Name="DropGlow" Grid.RowSpan="5" CornerRadius="20" Background="{Binding AccentSoft}" Opacity="0" IsHitTestVisible="False" />

                    <DockPanel Margin="14,16,8,0">
                        <Button DockPanel.Dock="Left" Style="{StaticResource DotButton}" Background="{Binding Accent}" Click="Color_Click"
                                ToolTip="Cambiar color" AutomationProperties.Name="Cambiar color del canal" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Content="&#xE712;" Click="ChannelMenu_Click"
                                ToolTip="Opciones del canal" AutomationProperties.Name="Opciones del canal">
                            <Button.ContextMenu>
                                <ContextMenu />
                            </Button.ContextMenu>
                        </Button>
                        <TextBox x:Name="NameBox" Style="{StaticResource NameBox}" Margin="8,0,2,0"
                                 Text="{Binding Name, UpdateSourceTrigger=LostFocus}" KeyDown="Name_KeyDown"
                                 ToolTip="Nombre del canal: así se llama su fuente en OBS" AutomationProperties.Name="Nombre del canal" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock x:Name="Percent" Text="{Binding Volume, StringFormat={}{0:0}}" FontFamily="{StaticResource Display}"
                                   FontSize="36" FontWeight="SemiBold" />
                        <TextBlock Text="%" Foreground="{StaticResource Dim}" FontSize="14" VerticalAlignment="Bottom" Margin="3,0,0,8" />
                    </StackPanel>

                    <Grid x:Name="FaderArea" Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="6" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="3" Background="{StaticResource Well}" />
                        <Border CornerRadius="3" Background="{Binding Accent}" RenderTransformOrigin="0.5,1" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="{Binding Peak}" />
                            </Border.RenderTransform>
                        </Border>
                        <Slider x:Name="Fader" Grid.Column="2" Style="{StaticResource Fader}" Value="{Binding Volume}" Foreground="{Binding Accent}"
                                AutomationProperties.Name="{Binding Name, StringFormat=Volumen de {0}}" />
                        <Border Grid.Column="4" CornerRadius="3" Background="{StaticResource Well}" />
                        <Border Grid.Column="4" CornerRadius="3" Background="{Binding Accent}" RenderTransformOrigin="0.5,1" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="{Binding Peak}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <ToggleButton Grid.Row="3" Margin="14,0,14,12" Style="{StaticResource MuteToggle}" IsChecked="{Binding Muted}"
                                  AutomationProperties.Name="{Binding Name, StringFormat=Silenciar {0}}" />

                    <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="#1A2236">
                        <Grid>
                            <TextBlock x:Name="Empty" Text="Arrastra programas aquí" Foreground="{StaticResource Faint}"
                                       HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,4" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppTemplate}" Focusable="False" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter TargetName="Fader" Property="Foreground" Value="{StaticResource Faint}" />
                    <Setter TargetName="Percent" Property="Foreground" Value="{StaticResource Faint}" />
                    <Setter TargetName="FaderArea" Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                    <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="DropGlow" Property="Opacity" Value="0.35" />
                    <Setter TargetName="Strip" Property="BorderBrush" Value="{Binding Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Two faint neon glows in the corners: drawn once, never animated. -->
            <Rectangle Grid.RowSpan="3" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.08,0" GradientOrigin="0.08,0" RadiusX="0.55" RadiusY="0.6">
                        <GradientStop Color="#2200E5FF" Offset="0" />
                        <GradientStop Color="#0000E5FF" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.RowSpan="3" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.95,1" GradientOrigin="0.95,1" RadiusX="0.5" RadiusY="0.6">
                        <GradientStop Color="#1AFF3D7F" Offset="0" />
                        <GradientStop Color="#00FF3D7F" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Header: logo, current output, OBS and the window buttons. -->
            <Grid Margin="22,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="34" Height="34">
                        <Border CornerRadius="10" Background="{StaticResource Neon}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="4" Height="10" RadiusX="2" RadiusY="2" Fill="White" VerticalAlignment="Bottom" />
                            <Rectangle Width="4" Height="18" RadiusX="2" RadiusY="2" Fill="White" Margin="3,0" VerticalAlignment="Bottom" />
                            <Rectangle Width="4" Height="13" RadiusX="2" RadiusY="2" Fill="White" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SACKMIX" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="Mezclador por programa" Foreground="{StaticResource Dim}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center" CornerRadius="15" Background="#121A29"
                        BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="12,6" ToolTip="Salida predeterminada de Windows">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7F6;" Foreground="#00E5FF" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding Output}" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="StartupToggle" Style="{StaticResource PillToggle}" Margin="0,0,10,0"
                                  WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Iniciar con Windows"
                                  ToolTip="Al encender el PC, SackMix arranca solo y espera en la bandeja, junto al reloj">
                        <TextBlock Text="Iniciar con Windows" VerticalAlignment="Center" />
                    </ToggleButton>
                    <Button x:Name="ObsButton" Style="{StaticResource NeonButton}" Click="Obs_Click" Margin="0,0,14,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Enviar a OBS"
                            ToolTip="Crea en OBS una «Captura de audio de aplicación» por programa, con el nombre de su canal">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE714;" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" Text="Enviar a OBS" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimizar" />
                    <Button x:Name="MaxButton" Style="{StaticResource IconButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximizar"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximizar" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Cerrar"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Cerrar" />
                </StackPanel>
            </Grid>

            <!-- Channels, side by side; scrolls sideways when the window is narrow. -->
            <ScrollViewer x:Name="Board" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Padding="22,6,6,0" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl x:Name="ChannelList" ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Style="{StaticResource AddTile}" Width="120" Margin="0,0,16,16" Click="AddChannel_Click"
                            AutomationProperties.Name="Nuevo canal">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE710;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,10,0,0" Text="Nuevo canal" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Margin="24,2,24,12" Foreground="{StaticResource Faint}" FontSize="12" TextTrimming="CharacterEllipsis"
                       Text="Arrastra un programa a otro canal o usa su clic derecho · Cada canal llega a OBS con su nombre" />

            <Border x:Name="Toast" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28"
                    MaxWidth="620" CornerRadius="12" Background="#EE161E2F" BorderBrush="#2E3A55" BorderThickness="1" Padding="16,10"
                    Visibility="Collapsed">
                <TextBlock x:Name="ToastText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Grid>
    </Border>
</Window>
