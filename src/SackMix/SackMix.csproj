<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF reads DPI awareness from app.manifest; WinForms is only the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>SackMix</RootNamespace>
    <AssemblyName>SackMix</AssemblyName>
    <AssemblyTitle>SackMix</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\sackmix.ico</ApplicationIcon>
    <!-- Lighter at rest: no background GC thread (the heap is a few MB). InvariantGlobalization is not an
         option: WPF's font cache needs culture data and the window never opens without it. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- One-file build: ./publish.ps1. Self-contained, so the PC needs nothing installed. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Uncompressed: mapped from the exe instead of unpacked into memory (SackSpace measured 69 MB vs 152 MB in use). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Precompiled: opens without waiting on the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\sackmix.ico" />
  </ItemGroup>

  <!-- WPF's implicit usings leave System.IO out (its Path clashes with Shapes.Path, which this app never uses). -->
  <ItemGroup>
    <Using Include="System.IO" />
    <!-- WinForms is only here for NotifyIcon: keep its names out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SackMix.Core\SackMix.Core.csproj" />
  </ItemGroup>
</Project>
